APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
LOG_FILE=var/logs/travel-agent-orchestrator.log

HOST=0.0.0.0
PORT=8002
API_BASE_URL=http://localhost:8002
HTTP_TIMEOUT_SECONDS=15
POLL_INTERVAL_SECONDS=1
POLL_TIMEOUT_SECONDS=600
WEB_STATE_SECRET=replace-with-a-random-local-value

# Default runtime: PostgreSQL installed as a local Windows service.
DB_URI=postgresql://postgres:replace-with-your-postgres-password@localhost:5432/travel_agent?sslmode=disable
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
# The following POSTGRES_* and COMPOSE_* values are only used by compose.yaml.
POSTGRES_DB=travel_agent
POSTGRES_USER=travel_agent
POSTGRES_PASSWORD=travel_agent
COMPOSE_POSTGRES_PORT=5433

# Keep session state and the Celery broker in separate Redis logical databases.
REDIS_URL=redis://localhost:6379/1
REDIS_KEY_PREFIX=travel-agent-orchestrator
SESSION_TIMEOUT_SECONDS=300
SESSION_TTL_SECONDS=3600
TASK_TTL_SECONDS=3600
CELERY_BROKER_URL=redis://localhost:6379/2
# Optional Docker Redis host port; it does not affect the local Windows service.
COMPOSE_REDIS_PORT=6380

LLM_TYPE=qwen
DEFAULT_CHAT_MODEL=qwen3.8-max
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
SUPERVISOR_MODEL=
DISCOVERY_MODEL=
BOOKING_MODEL=
SERVICE_MODEL=
SUPERVISOR_CONFIDENCE_THRESHOLD=0.65
MAX_HANDOFFS_PER_TASK=6
MAX_READ_ONLY_TOOL_CALLS_PER_AGENT=8
GRAPH_RECURSION_LIMIT=80
MODEL_CONTEXT_WINDOW_TOKENS=32768
MODEL_MAX_INPUT_TOKENS=30720
CONTEXT_COMPRESSION_RATIO=0.70
CONTEXT_RECENT_TURNS=5
CONTEXT_SUMMARY_MAX_TOKENS=1200
TOOL_ARTIFACT_INLINE_MAX_BYTES=8192
TOOL_ARTIFACT_PAGE_SIZE=5
OPENAI_BASE_URL=
OPENAI_API_KEY=
ONEAPI_BASE_URL=
ONEAPI_API_KEY=
DASHSCOPE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
AMAP_MAPS_API_KEY=
SANDBOX_PAYMENT_MODE=success
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=travel-agent-orchestrator
LANGSMITH_API_KEY=
